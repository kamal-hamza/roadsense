<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Only keys that have no INFOPLIST_KEY_* build setting live here. Everything else
  (usage descriptions, display name, ...) is generated from build settings.
-->
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- RoadSense server, from the ROADSENSE_API_BASE_URL build setting. Empty means the app uses demo data. -->
	<key>RSAPIBaseURL</key>
	<string>$(ROADSENSE_API_BASE_URL)</string>
	<!-- Plain HTTP only to local hosts (the dev server on this Mac); everything else stays HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
